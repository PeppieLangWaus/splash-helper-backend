# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/splash-helper

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
SETUP_LINK_SECRET=change-me-to-another-long-random-secret
# Duration for setup links: e.g. 24h, 7d, 1h
SETUP_LINK_EXPIRY=24h

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-strong-admin-secret

# Local dev only — ignored unless NODE_ENV != production. If set, this exact
# username is auto-(re)granted isAdmin + communityEligible on every WS AUTH,
# so a personal test account stays admin across dev:local's data resets
# (dev:local's DB now persists across restarts in .devdata/mongo — this
# matters after wiping it via POST /dev/reset or deleting that folder).
# Leave unset on any shared/staging/production environment.
# LOCAL_DEV_ADMIN_USERNAME=YourTestAccountName

# ── Frontend URL (used in generated setup links) ─────────────────────────────
FRONTEND_URL=https://example.com

# ── URL shortener (Ardy-Host-URL-shortener, deployed separately) ────────────
# Optional: if either is unset, generateSetupLink() just returns the long
# splasher.help/setup?token=... URL instead of shortening it. Must match the
# SETUP_LINK_SECRET above with that service's own SETUP_LINK_SECRET env var.
# SHORTENER_API_URL=https://link.ardy.host/api/links
# SHORTENER_API_KEY=change-me-must-match-the-shortener-service-API_KEY

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allow requests from the frontend domain
CORS_ORIGIN_API=https://example.com

# ── Item log resolution (!log/!pets, via chat-relay) ─────────────────────────
# Resolves real item ids for `!log <page>`/`!pets` chat lines against RuneProfile's and
# RuneLite's own public APIs — see services/itemLogResolver.ts. Every call is unauthenticated
# and self-rate-limited until an API token is issued and set here (RuneProfile has been asked
# for one). Leave commented out until then.
# RUNEPROFILE_API_TOKEN=change-me-once-runeprofile-issues-a-token
#
# Self-imposed outbound rate limit — requests per window, per destination. Defaults (30/60s each)
# are conservative and rarely worth touching; only override if real-world traffic needs a
# different cap, or once an issued token comes with a documented higher allowance.
# RUNEPROFILE_RATE_LIMIT_MAX=30
# RUNEPROFILE_RATE_LIMIT_WINDOW_MS=60000
# RUNELITE_RATE_LIMIT_MAX=30
# RUNELITE_RATE_LIMIT_WINDOW_MS=60000

# ── Discord webhooks ──────────────────────────────────────────────────────────
# Create webhooks in Discord: Server Settings > Integrations > Webhooks
# Active splashers embed (sends/edits a persistent status message)
DISCORD_ACTIVE_WEBHOOK_URL=https://discord.com/api/webhooks/your/active-webhook
# Archived session notifications
DISCORD_ARCHIVED_WEBHOOK_URL=https://discord.com/api/webhooks/your/archived-webhook
# How often the active splashers message is edited, in ms (default: 20000)
DISCORD_EMBED_UPDATE_INTERVAL_MS=20000
